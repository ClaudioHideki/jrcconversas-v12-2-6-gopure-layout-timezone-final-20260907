# Copie para .env no servidor HML. Nunca comite o arquivo preenchido.
JRC_CONVERSAS_IMAGE=ghcr.io/claudiohideki/jrcconversas-v12-2-6-gopure-layout-timezone-final-20260907@sha256:SUBSTITUIR_PELO_DIGEST_PUBLICADO
FRONTEND_URL=https://conversas-hml.example.invalid
HML_HTTP_PORT=3301
POSTGRES_PASSWORD=SUBSTITUIR_POR_SENHA_EXCLUSIVA_HML
SECRET_KEY_BASE=SUBSTITUIR_POR_SEGREDO_EXCLUSIVO_PERSISTENTE
# Chave Base64 de exatamente 32 bytes, criada uma vez e mantida entre reinicios.
JRC_BROKER_CREDENTIAL_KEY=SUBSTITUIR_POR_BASE64_32_BYTES
JRC_BROKER_ALLOWED_ORIGINS=https://broker-hml.example.invalid
JRC_BROKER_ENABLED=true
JRC_FLOWS_ENABLED=true
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
# Configurar HTTPS no proxy reverso antes de criar a integracao.
FORCE_SSL=true
