<% content_for(:title) do %>
  Vídeo Conferência — Configurar Agentes
<% end %>

<header class="flex items-center border-b border-n-weak px-8 py-4" role="banner">
  <div class="mr-4 rounded-full border border-n-weak p-2">
    <svg width="24" height="24"><use xlink:href="#icon-apps-2-line" /></svg>
  </div>
  <div class="flex flex-col justify-center">
    <h1 class="text-base font-medium leading-6 text-n-slate-12" id="page-title">Vídeo Conferência</h1>
    <p class="m-0 text-sm font-normal leading-5 text-slate-500">Configure as URLs de moderador e espectador de cada agente.</p>
  </div>
</header>

<section class="main-content__body px-8 py-6">
  <div class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= form_with url: super_admin_video_conference_settings_path, method: :get, local: true, class: 'grid grid-cols-1 gap-3 md:grid-cols-[minmax(240px,1fr)_minmax(260px,1fr)_auto]' do |form| %>
      <label>
        <span class="mb-2 block text-sm font-medium text-slate-800">Cliente / Conta</span>
        <%= form.select :account_id,
                        options_from_collection_for_select(@accounts, :id, :name, @account&.id),
                        {},
                        class: 'h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
      </label>
      <label>
        <span class="mb-2 block text-sm font-medium text-slate-800">Pesquisar agente</span>
        <%= text_field_tag :query, params[:query], placeholder: 'Nome ou e-mail', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
      </label>
      <%= form.submit 'Pesquisar', class: 'mt-auto h-11 cursor-pointer rounded-lg border-0 bg-woot-500 px-5 text-sm font-medium text-white hover:bg-woot-600' %>
    <% end %>
  </div>

  <% if @account.nil? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-25 p-10 text-center text-sm text-slate-600">
      Nenhuma conta foi cadastrada nesta instalação.
    </div>
  <% else %>
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-woot-600">Cliente selecionado</p>
        <h2 class="mt-1 text-xl font-semibold text-slate-900"><%= @account.name %></h2>
      </div>
      <% configured_count = @settings_by_user_id.values.count(&:configured?) %>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-medium text-slate-700">
        <%= configured_count %>/<%= @agents.size %> agentes configurados
      </span>
    </div>

    <div class="grid grid-cols-1 gap-5 xl:grid-cols-[420px_minmax(0,1fr)]">
      <aside class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-5 py-4">
          <h3 class="text-sm font-semibold text-slate-900">Agentes do cliente</h3>
          <p class="mt-1 text-xs text-slate-500"><%= @agents.size %> resultado(s)</p>
        </div>

        <% if @agents.empty? %>
          <div class="p-8 text-center text-sm text-slate-500">
            Nenhum agente encontrado para esta conta e pesquisa.
          </div>
        <% else %>
          <div class="max-h-[680px] space-y-2 overflow-y-auto p-3">
            <% @agents.each do |agent| %>
              <% setting = @settings_by_user_id[agent.id] %>
              <% selected = agent.id == @selected_agent&.id %>
              <%= link_to super_admin_video_conference_settings_path(account_id: @account.id, user_id: agent.id, query: params[:query]),
                          class: "block rounded-xl border p-3 transition #{selected ? 'border-woot-500 bg-woot-50' : 'border-transparent hover:border-slate-200 hover:bg-slate-25'}" do %>
                <span class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-sm font-bold text-slate-700">
                    <%= (agent.available_name.presence || agent.email).first(2).upcase %>
                  </span>
                  <span class="min-w-0 flex-1">
                    <strong class="block truncate text-sm text-slate-900"><%= agent.available_name %></strong>
                    <span class="block truncate text-xs text-slate-500"><%= agent.email %></span>
                  </span>
                  <span class="text-xs font-medium text-woot-600"><%= setting ? 'Editar' : 'Configurar' %></span>
                </span>
                <span class="mt-3 grid grid-cols-2 gap-2 text-xs">
                  <span class="rounded-md bg-slate-50 px-2 py-1.5 text-slate-600">Moderador: <strong><%= setting&.moderator_url.present? ? 'Configurado' : 'Não definido' %></strong></span>
                  <span class="rounded-md bg-slate-50 px-2 py-1.5 text-slate-600">Espectador: <strong><%= setting&.spectator_url.present? ? 'Configurado' : 'Não definido' %></strong></span>
                </span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </aside>

      <% if @selected_agent %>
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm lg:p-8">
          <div class="mb-7 border-b border-slate-200 pb-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-woot-600">Configurar agente</p>
            <h3 class="mt-1 text-base font-semibold text-slate-900"><%= @selected_agent.available_name %></h3>
            <p class="mt-1 text-sm text-slate-500"><%= @selected_agent.email %></p>
          </div>

          <%= form_with url: super_admin_video_conference_setting_path(@selected_agent, account_id: @account.id), method: :patch, local: true do |form| %>
            <div class="grid grid-cols-1 gap-5">
              <label>
                <span class="mb-2 block text-sm font-medium text-slate-700">URL Moderador</span>
                <%= url_field_tag 'video_conference_setting[moderator_url]', @setting&.moderator_url, placeholder: 'https://...', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
              </label>
              <label>
                <span class="mb-2 block text-sm font-medium text-slate-700">Senha da sala do Moderador</span>
                <%= password_field_tag 'video_conference_setting[moderator_password]', nil, autocomplete: 'new-password', placeholder: @setting&.moderator_password.present? ? 'Senha protegida — deixe em branco para preservar' : 'Senha usada para entrar como Moderador', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
              </label>
              <label>
                <span class="mb-2 block text-sm font-medium text-slate-700">URL Espectador</span>
                <%= url_field_tag 'video_conference_setting[spectator_url]', @setting&.spectator_url, placeholder: 'https://...', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
              </label>
              <label>
                <span class="mb-2 block text-sm font-medium text-slate-700">Senha da sala do Espectador</span>
                <%= password_field_tag 'video_conference_setting[spectator_password]', nil, autocomplete: 'new-password', placeholder: @setting&.spectator_password.present? ? 'Senha protegida — deixe em branco para preservar' : 'Senha usada para entrar como Espectador', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm text-slate-900 focus:border-woot-500 focus:outline-none' %>
              </label>
              <p class="text-xs text-slate-500">
                As senhas são criptografadas no banco. Depois de salvas, deixe o campo em branco para preservar a senha atual.
              </p>
              <p class="rounded-lg bg-slate-50 px-4 py-3 text-xs text-slate-600">
                A funcionalidade aparece automaticamente para o agente quando pelo menos uma URL HTTPS válida estiver preenchida. Apague as duas URLs para ocultá-la.
              </p>
            </div>

            <div class="mt-7 flex flex-wrap gap-3">
              <%= form.submit 'Salvar', class: 'cursor-pointer rounded-lg border-0 bg-woot-500 px-5 py-3 text-sm font-medium text-white hover:bg-woot-600' %>
              <% if @setting %>
                <%= link_to 'Remover configuração',
                            super_admin_video_conference_setting_path(@selected_agent, account_id: @account.id),
                            data: { turbo_method: :delete, turbo_confirm: 'Deseja remover as URLs de vídeo conferência deste agente?' },
                            class: 'rounded-lg border border-red-200 bg-red-50 px-5 py-3 text-sm font-medium text-red-700 hover:bg-red-100' %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-[360px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-25 p-8 text-center text-sm text-slate-500">
          Selecione uma conta que possua agentes ou ajuste a pesquisa.
        </div>
      <% end %>
    </div>
  <% end %>
</section>
