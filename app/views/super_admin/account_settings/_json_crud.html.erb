<section class="mb-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="mb-5 text-lg font-semibold text-slate-900"><%= title %></h2>
  <%= form_with url: account_setting_resource_path(resource), method: :post, local: true, class: 'grid grid-cols-1 gap-4 lg:grid-cols-3' do %>
    <label>
      <span class="mb-2 block text-sm font-medium text-slate-700">Nome</span>
      <%= text_field_tag "#{resource}[#{name_field}]", nil, required: true, class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
    </label>
    <% extra_fields.each do |field| %>
      <label>
        <span class="mb-2 block text-sm font-medium text-slate-700"><%= field.to_s.humanize %></span>
        <% if field == :visibility %>
          <%= select_tag "#{resource}[#{field}]", options_for_select(Macro.visibilities.keys), class: 'h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm' %>
        <% elsif field == :event_name %>
          <%= text_field_tag "#{resource}[#{field}]", 'conversation_created', class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
        <% else %>
          <%= text_field_tag "#{resource}[#{field}]", nil, class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
        <% end %>
      </label>
    <% end %>
    <% json_fields.each do |param_name, label, _attribute| %>
      <label class="lg:col-span-3">
        <span class="mb-2 block text-sm font-medium text-slate-700"><%= label %></span>
        <%= text_area_tag "#{resource}[#{param_name}]", '[]', rows: 4, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-mono' %>
      </label>
    <% end %>
    <% if resource == 'automation' %>
      <label class="flex items-center gap-2 lg:col-span-3">
        <%= hidden_field_tag "#{resource}[active]", '0' %>
        <%= check_box_tag "#{resource}[active]", '1', true, class: 'h-4 w-4 rounded border-slate-300 text-woot-500' %>
        <span class="text-sm text-slate-700">Ativa</span>
      </label>
    <% end %>
    <%= submit_tag "Criar #{title.singularize}", class: 'h-11 cursor-pointer rounded-lg border-0 bg-woot-500 px-5 text-sm font-medium text-white lg:col-span-3' %>
  <% end %>
</section>

<div class="grid grid-cols-1 gap-4">
  <% records.each do |record| %>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <%= form_with url: account_setting_resource_path(resource, record.id), method: :patch, local: true, class: 'grid grid-cols-1 gap-3 lg:grid-cols-3' do %>
        <label>
          <span class="mb-1 block text-xs font-medium text-slate-500">Nome</span>
          <%= text_field_tag "#{resource}[#{name_field}]", record.public_send(name_field), required: true, class: 'h-10 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
        </label>
        <% extra_fields.each do |field| %>
          <label>
            <span class="mb-1 block text-xs font-medium text-slate-500"><%= field.to_s.humanize %></span>
            <% if field == :visibility %>
              <%= select_tag "#{resource}[#{field}]", options_for_select(Macro.visibilities.keys, record.visibility), class: 'h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm' %>
            <% elsif field == :event_name %>
              <%= text_field_tag "#{resource}[#{field}]", record.event_name, class: 'h-10 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
            <% else %>
              <%= text_field_tag "#{resource}[#{field}]", record.public_send(field), class: 'h-10 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
            <% end %>
          </label>
        <% end %>
        <% json_fields.each do |param_name, label, attribute| %>
          <label class="lg:col-span-3">
            <span class="mb-1 block text-xs font-medium text-slate-500"><%= label %></span>
            <%= text_area_tag "#{resource}[#{param_name}]", JSON.pretty_generate(record.public_send(attribute) || []), rows: 4, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-mono' %>
          </label>
        <% end %>
        <% if resource == 'automation' %>
          <label class="flex items-center gap-2 lg:col-span-3">
            <%= hidden_field_tag "#{resource}[active]", '0' %>
            <%= check_box_tag "#{resource}[active]", '1', record.active?, class: 'h-4 w-4 rounded border-slate-300 text-woot-500' %>
            <span class="text-sm text-slate-700">Ativa</span>
          </label>
        <% end %>
        <%= submit_tag 'Salvar', class: 'h-10 cursor-pointer rounded-lg border-0 bg-woot-500 px-4 text-sm font-medium text-white' %>
      <% end %>
      <%= button_to 'Excluir',
                    account_setting_resource_path(resource, record.id),
                    method: :delete,
                    form: { class: 'mt-3', data: { turbo_confirm: 'Excluir este registro?' } },
                    class: 'rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700' %>
    </section>
  <% end %>
</div>
