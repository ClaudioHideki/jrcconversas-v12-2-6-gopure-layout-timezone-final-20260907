<section class="mb-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="mb-5 text-lg font-semibold text-slate-900"><%= title %></h2>
  <%= form_with url: account_setting_resource_path(resource), method: :post, local: true, class: 'grid grid-cols-1 gap-4 lg:grid-cols-3' do %>
    <% fields.each do |field, label, type| %>
      <label class="<%= 'lg:col-span-3' if type == :textarea %>">
        <span class="mb-2 block text-sm font-medium text-slate-700"><%= label %></span>
        <% if type == :textarea %>
          <%= text_area_tag "#{resource}[#{field}]", nil, rows: 4, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-sm' %>
        <% elsif type == :color %>
          <%= color_field_tag "#{resource}[#{field}]", '#1f93ff', class: 'h-11 w-full rounded-lg border border-slate-200 px-2' %>
        <% else %>
          <%= text_field_tag "#{resource}[#{field}]", nil, type: type, class: 'h-11 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
        <% end %>
      </label>
    <% end %>
    <%= submit_tag "Criar #{title.singularize}", class: 'h-11 cursor-pointer rounded-lg border-0 bg-woot-500 px-5 text-sm font-medium text-white lg:col-span-3' %>
  <% end %>
</section>

<div class="grid grid-cols-1 gap-4">
  <% records.each do |record| %>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <%= form_with url: account_setting_resource_path(resource, record.id), method: :patch, local: true, class: 'grid grid-cols-1 gap-3 lg:grid-cols-3' do %>
        <% fields.each do |field, label, type| %>
          <label class="<%= 'lg:col-span-3' if type == :textarea %>">
            <span class="mb-1 block text-xs font-medium text-slate-500"><%= label %></span>
            <% value = record.public_send(field) %>
            <% if type == :textarea %>
              <%= text_area_tag "#{resource}[#{field}]", value, rows: 4, class: 'w-full rounded-lg border border-slate-200 px-3 py-2 text-sm' %>
            <% elsif type == :color %>
              <%= color_field_tag "#{resource}[#{field}]", value.presence || '#1f93ff', class: 'h-10 w-full rounded-lg border border-slate-200 px-2' %>
            <% else %>
              <%= text_field_tag "#{resource}[#{field}]", value, type: type, class: 'h-10 w-full rounded-lg border border-slate-200 px-3 text-sm' %>
            <% end %>
          </label>
        <% end %>
        <%= submit_tag 'Salvar', class: 'h-10 cursor-pointer rounded-lg border-0 bg-woot-500 px-4 text-sm font-medium text-white' %>
      <% end %>
      <%= button_to 'Excluir',
                    account_setting_resource_path(resource, record.id),
                    method: :delete,
                    form: { class: 'mt-3', data: { turbo_confirm: 'Excluir este registro?' } },
                    class: 'rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-700' %>
    </section>
  <% end %>
</div>
