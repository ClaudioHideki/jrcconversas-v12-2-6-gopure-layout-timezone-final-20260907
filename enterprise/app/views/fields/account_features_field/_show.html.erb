<div class="w-full">
  <% regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data) %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    <% regular_features.each do |key_array, val| %>
      <% feature_key, display_name = key_array %>

      <div class="flex items-center justify-between p-3 bg-white rounded-md outline outline-n-container outline-1 shadow-sm">
        <span class="text-sm text-n-slate-12">
          <%= display_name %>
        </span>

        <%= button_to(
              raw(
                val == true ?
                  '<svg width="12" height="12"><use xlink:href="#icon-tick-line" /></svg>' :
                  '<span style="font-size:12px;font-weight:bold;line-height:12px;">×</span>'
              ),
              toggle_feature_super_admin_account_path(
                page.resource,
                feature: feature_key
              ),
              method: :post,
              form: {
                class: 'inline-flex'
              },
              class: 'rounded-full p-1 inline-flex items-center justify-center transition',
              style: (
                val == true ?
                  'background-color:#22c55e !important;color:#ffffff !important;width:24px;height:24px;border:none;' :
                  'background-color:#cbd5e1 !important;color:#475569 !important;width:24px;height:24px;border:none;'
              ),
              title: (
                val == true ?
                  'Desativar funcionalidade' :
                  'Ativar funcionalidade'
              )
            ) %>
      </div>
    <% end %>
  </div>

  <hr class="my-8 border-t border-n-weak">

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    <% premium_features.each do |key_array, val| %>
      <% feature_key, display_name = key_array %>

      <div class="flex items-center justify-between p-3 bg-white rounded-md outline outline-n-container outline-1 shadow-sm">
        <div class="flex items-center gap-2">
          <span class="bg-n-amber-3 text-n-amber-12 rounded-full p-1 inline-flex">
            <svg width="12" height="12">
              <use xlink:href="#icon-lock-line" />
            </svg>
          </span>

          <span class="text-sm text-n-slate-12">
            <%= display_name %>
          </span>
        </div>

        <%= button_to(
              raw(
                val == true ?
                  '<svg width="12" height="12"><use xlink:href="#icon-tick-line" /></svg>' :
                  '<span style="font-size:12px;font-weight:bold;line-height:12px;">×</span>'
              ),
              toggle_feature_super_admin_account_path(
                page.resource,
                feature: feature_key
              ),
              method: :post,
              form: {
                class: 'inline-flex'
              },
              class: 'rounded-full p-1 inline-flex items-center justify-center transition',
              style: (
                val == true ?
                  'background-color:#22c55e !important;color:#ffffff !important;width:24px;height:24px;border:none;' :
                  'background-color:#cbd5e1 !important;color:#475569 !important;width:24px;height:24px;border:none;'
              ),
              title: (
                val == true ?
                  'Desativar funcionalidade' :
                  'Ativar funcionalidade'
              )
            ) %>
      </div>
    <% end %>
  </div>
</div>